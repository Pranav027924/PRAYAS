# Build context hygiene. Without this the whole working tree — including the
# virtualenv, coverage artifacts and the git history — is uploaded to the
# daemon on every build, which is slow and puts local secrets one COPY away
# from the image.
.git
.github
.venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage*
mutants
.env
*.dump
docs
tests
packages/*/tests
