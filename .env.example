# Copy to .env for local development. NEVER commit .env.
#
# Two roles by design (ADR-004):
#   owner  — owns the schema, runs migrations, holds DDL rights
#   app    — owns nothing, is subject to RLS unconditionally
# The application must never use the owner URL.

POSTGRES_DB=prayas
POSTGRES_OWNER_USER=prayas_owner
POSTGRES_OWNER_PASSWORD=prayas_local_dev_only
POSTGRES_APP_USER=prayas_app
POSTGRES_APP_PASSWORD=prayas_local_dev_only

# Consumed by Alembic (DDL). Owner role.
PRAYAS_DATABASE_URL_OWNER=postgresql+asyncpg://prayas_owner:prayas_local_dev_only@localhost:5432/prayas

# Consumed by the application. Non-owner role, RLS-constrained.
PRAYAS_DATABASE_URL_APP=postgresql+asyncpg://prayas_app:prayas_local_dev_only@localhost:5432/prayas

PRAYAS_ENV=local
PRAYAS_LOG_LEVEL=INFO

# Pseudonymisation pepper for consent withdrawal (Master Spec §28, ADR-078).
# `forget()` refuses to run without it: a pseudonym derived from identifiers
# alone is reversible by anyone holding a customer list, so there is no safe
# default and the code fails closed rather than inventing one.
#
# In a real deployment this is a managed secret, and **rotating it breaks the
# link to every pseudonym already written** — erased customers would stop
# matching their own suppression rows. Treat it as permanent per environment.
PRAYAS_PSEUDONYM_PEPPER=local_dev_pepper_not_a_secret
